# Entorno
NODE_ENV=development
TZ=America/Bogota
PORT=3000

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=nodestore
DB_PORT=3306
DB_NAME_TEST=nodestore_test
# Usar true si el proveedor exige SSL (Neon/PlanetScale/Algunos managed)
DB_SSL=false

# Autenticación
JWT_SECRET=cambia_esto_por_una_clave_larga_y_unica
JWT_EXPIRES_IN=1d

# CORS / Orígenes permitidos
# Separados por coma. Ej: https://tu-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Agenda
SLOT_MINUTOS=30

# WhatsApp Cloud API (SOLO BACKEND)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# En producción solo habilitar si realmente lo vas a usar sin Meta
WHATSAPP_SIMULADOR=0
