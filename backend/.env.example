DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=nodestore
DB_PORT=3306
PORT=3000
SLOT_MINUTOS=30
JWT_SECRET=tu_clave_secreta_aqui
JWT_EXPIRES_IN=1d

# WhatsApp Cloud API (solo backend; nunca exponer en el frontend)
# Token de acceso de la app de Meta (los tokens de prueba caducan ~24 h).
WHATSAPP_TOKEN=
# ID del número de teléfono de prueba en Meta.
WHATSAPP_PHONE_NUMBER_ID=
# Token que se configura en "Verificar y guardar" del webhook.
WHATSAPP_VERIFY_TOKEN=
# App Secret de Meta, usado para validar X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Versión de la Graph API (por defecto v23.0).
WHATSAPP_API_VERSION=v23.0
# Habilitar el simulador en producción (en desarrollo siempre está activo).
WHATSAPP_SIMULADOR=0
